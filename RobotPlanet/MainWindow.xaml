<Window x:Class="RobotPlanet.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Robot Planet"
    Height="700"
    Width="900"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">

                <TextBlock Text="Search"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Robots"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <ListBox x:Name="RobotListBox"
                         Height="220"
                         DisplayMemberPath="Name"
                         ItemsSource="{Binding DisplayedRobots}"
                         SelectedItem="{Binding SelectedRobot, Mode=TwoWay}"
                         Margin="0,0,0,10"/>


                <TextBlock Text="Robot Summary"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <ListBox ItemsSource="{Binding GroupSummary}" 
                         Height="80" 
                         Margin="0,0,0,15"/>

                <TextBlock Text="Sorted By Name"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <ListBox Height="120" 
                         DisplayMemberPath="Name"
                         ItemsSource="{Binding DisplayedRobots}"
                         Margin="0,0,0,10"/>


                <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                    <Button Content="Filter" Command="{Binding ApplyFilterCommand}" Height="28" Margin="0,0,0,3"/>
                    <Button Content="Sort by Battery" Command="{Binding SortCommand}" Height="28" Margin="0,0,0,3"/>
                    <Button Content="Group by Type" Command="{Binding GroupCommand}" Height="28"/>
                </StackPanel>

            </StackPanel>

        <StackPanel Grid.Column="1">


            <TextBlock Text="Add Robot"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Robot Name:" FontSize="12" Margin="0,0,0,3"/>
            <TextBox Text="{Binding NewRobotName, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Robot Type:" FontSize="12" Margin="0,0,0,3"/>
            <ComboBox ItemsSource="{Binding Types}"
                      SelectedItem="{Binding SelectedType}"
                      Height="30"
                      Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Add Robot"
                        Height="32"
                        Padding="5"
                        Command="{Binding AddCommand}"
                        Margin="0,0,5,0"/>
                <Button Content="Remove Robot"
                        Height="32"
                        Padding="5"
                        Command="{Binding RemoveCommand}"/>
            </StackPanel>


            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Work" Width="70" Height="28" Margin="0,0,3,0" Command="{Binding PerformTaskCommand}"/>
                <Button Content="Crazy Action" Width="85" Height="28" Margin="0,0,3,0" Command="{Binding CrazyCommand}"/>
                <Button Content="Charge" Width="70" Height="28" Margin="0,0,3,0" Command="{Binding ChargeCommand}"/>
                <Button Content="Scan" Width="70" Height="28" Margin="0,0,3,0" Command="{Binding ScanCommand}"/>
                <Button Content="Repair" Width="70" Height="28" Command="{Binding RepairCommand}"/>
            </StackPanel>


            <TextBlock Text="Robot Details"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Name:" FontWeight="Bold" Grid.Column="0" Grid.Row="0" Margin="0,0,10,3"/>
                <TextBlock Text="{Binding SelectedRobot.Name, TargetNullValue='None'}" Grid.Column="1" Grid.Row="0" Margin="0,0,0,3"/>

                <TextBlock Text="Type:" FontWeight="Bold" Grid.Column="0" Grid.Row="1" Margin="0,0,10,3"/>
                <TextBlock Grid.Column="1" Grid.Row="1" Margin="0,0,0,3" Text="{Binding SelectedRobot, TargetNullValue=None}"/>

                <TextBlock Text="Battery:" FontWeight="Bold" Grid.Column="0" Grid.Row="2" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <ProgressBar Value="{Binding SelectedRobot.Battery, Mode=OneWay, TargetNullValue=0}"
                             Height="20"
                             Maximum="100"
                             Grid.Column="1" Grid.Row="2"/>
            </Grid>


            <TextBlock Text="Simulation"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Workload:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                <TextBox Text="{Binding SimulationWorkloadInput, UpdateSourceTrigger=PropertyChanged}" 
                         Grid.Column="1"
                         Width="150" Height="30"/>
            </Grid>

            <TextBlock Text="Simulation Robots" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" 
                          ItemsSource="{Binding AvailableRobots}"
                          SelectedItem="{Binding SimulationRobot1, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Height="30"/>

                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding AvailableRobots}"
                          SelectedItem="{Binding SimulationRobot2, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Height="30"/>

                <ComboBox Grid.Column="4" 
                          ItemsSource="{Binding AvailableRobots}"
                          SelectedItem="{Binding SimulationRobot3, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Height="30"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Command="{Binding RunSequentialCommand}" 
                        Content="Run Sequential" 
                        Width="120" Height="32" Margin="0,0,10,0" Padding="5"/>
                <Button Command="{Binding RunParallelCommand}" 
                        Content="Run Parallel" 
                        Width="120" Height="32" Margin="0,0,10,0" Padding="5"/>
                <Button Command="{Binding SimulationCancelCommand}" 
                        Content="Cancel" 
                        Width="80" Height="32" Padding="5"/>
            </StackPanel>

            <TextBlock Text="Simulation Results" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
            <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding SimulationResults}" CanUserAddRows="False" Height="150" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Robot" Binding="{Binding RobotName}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding Result, StringFormat=F2}" Width="100"/>
                    <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs}" Width="80"/>
                    <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Log"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <ListBox ItemsSource="{Binding Log}"
                     Height="150"/>

        </StackPanel>

        </Grid>
    </ScrollViewer>

</Window>