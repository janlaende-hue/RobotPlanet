<Window x:Class="RobotPlanet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Planet"
        Height="522"
        Width="767">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">

            <TextBlock Text="Robots"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <ListBox x:Name="RobotListBox"
                     Height="420"
                     DisplayMemberPath="Name"
                     SelectionChanged="RobotListBox_SelectionChanged"/>

        </StackPanel>
        <StackPanel Grid.Column="1"
                    Margin="15,0">

            <TextBlock Text="Name"/>

            <TextBox x:Name="NameTextBox"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Robot Type"/>

            <ComboBox x:Name="RobotTypeComboBox"
                      Margin="0,5,0,15">

                <ComboBoxItem Content="CleanerBot"/>
                <ComboBoxItem Content="ExplorerBot"/>
                <ComboBoxItem Content="RepairBot"/>
                <ComboBoxItem Content="GuardBot"/>

            </ComboBox>

            <Button Content="Add Robot"
                    Height="30"
                    Click="AddRobot_Click"/>
            <Button Content="Remove Robot"
                    Click="RemoveRobot_Click" Height="32"/>

        </StackPanel>
        <StackPanel Grid.Column="2"
                    Margin="15,0">

            <TextBlock Text="Actions"
                       FontSize="18"
                       FontWeight="Bold"/>

            <ProgressBar x:Name="BatteryBar"
                         Height="20"
                         Maximum="100"
                         Margin="0,10,0,15"/>

            <WrapPanel>

                <Button Content="Task"
                        Width="90"
                        Margin="3"
                        Click="PerformTask_Click"/>

                <Button Content="Crazy"
                        Width="90"
                        Margin="3"
                        Click="CrazyAction_Click"/>

                <Button Content="Scan"
                        Width="90"
                        Margin="3"
                        Click="Scan_Click"/>

                <Button Content="Repair"
                        Width="90"
                        Margin="3"
                        Click="Repair_Click"/>

                <Button Content="Charge"
                        Width="90"
                        Margin="3"
                        Click="Charge_Click"/>

            </WrapPanel>

            <TextBlock Text="Logs"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,20,0,10"/>

            <ListBox x:Name="LogListBox"
                     Height="300"/>

        </StackPanel>

    </Grid>

</Window>